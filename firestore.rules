rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'ibXYNXnkluZFX4W0hddFoZ3TGa42';
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.active == true
        && (
          get(profilePath()).data.role == 'guest'
          || !get(profilePath()).data.keys().hasAny(['expiresAt'])
          || get(profilePath()).data.expiresAt == null
          || request.time < get(profilePath()).data.expiresAt
        );
    }

    function hasRole(roleName) {
      return hasActiveProfile()
        && get(profilePath()).data.role == roleName;
    }

    function isMember() {
      return hasRole('member');
    }

    function isVocalist() {
      return hasRole('vocalist');
    }

    function isGuest() {
      return hasRole('guest');
    }

    function canUseBandClick() {
      return isAdmin() || isMember() || isVocalist();
    }

    function isBandClickMaster() {
      return isMember()
        && (
          get(profilePath()).data.displayName == 'Paweł'
          || get(profilePath()).data.displayName == 'Pawel'
        );
    }

    function validBandClickSession() {
      return request.resource.data.keys().hasOnly([
          'playing',
          'bpm',
          'beatsPerBar',
          'countInBars',
          'setlistId',
          'setlistName',
          'songId',
          'songTitle',
          'songArtist',
          'startAt',
          'revision',
          'updatedBy',
          'updatedByUid',
          'updatedAt'
        ])
        && request.resource.data.playing is bool
        && request.resource.data.bpm is number
        && request.resource.data.bpm >= 30
        && request.resource.data.bpm <= 300
        && request.resource.data.beatsPerBar is int
        && request.resource.data.beatsPerBar in [2, 3, 4, 5, 6, 7]
        && request.resource.data.countInBars is int
        && request.resource.data.countInBars >= 0
        && request.resource.data.countInBars <= 2
        && request.resource.data.setlistId is string
        && request.resource.data.setlistName is string
        && request.resource.data.songId is string
        && request.resource.data.songTitle is string
        && request.resource.data.songArtist is string
        && (
          request.resource.data.startAt == null
          || request.resource.data.startAt is timestamp
        )
        && (
          request.resource.data.playing == false
          || request.resource.data.startAt is timestamp
        )
        && request.resource.data.revision is int
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
    }

    function memberMusicalEdit() {
      return isMember()
        && request.resource.data.updatedUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'artist',
          'title',
          'bpm',
          'key',
          'bandKey',
          'vocal',
          'language',
          'yt',
          'ytId',
          'notes',
          'updatedBy',
          'updatedUid',
          'updatedAt'
        ]);
    }

    function memberDeleteRequest() {
      return isMember()
        && request.resource.data.updatedUid == request.auth.uid
        && request.resource.data.deleteRequestedUid == request.auth.uid
        && resource.data.pendingDelete != true
        && request.resource.data.pendingDelete == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pendingDelete',
          'deleteRequestedBy',
          'deleteRequestedUid',
          'deleteRequestedAt',
          'updatedBy',
          'updatedUid',
          'updatedAt'
        ]);
    }

    function canCreateWaitlistSong() {
      return (isMember() || isVocalist())
        && request.resource.data.status == '⏳ Poczekalnia'
        && request.resource.data.pendingDelete == false
        && request.resource.data.addedUid == request.auth.uid
        && request.resource.data.updatedUid == request.auth.uid;
    }

    match /profiles/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if isAdmin() || isMember() || isVocalist() || isGuest();

      allow create: if isAdmin() || canCreateWaitlistSong();

      allow update: if isAdmin()
        || memberMusicalEdit()
        || memberDeleteRequest();

      allow delete: if isAdmin();
    }

    match /setlists/{setlistId} {
      allow read: if isAdmin() || isMember() || isVocalist() || isGuest();
      allow create, update, delete: if isAdmin() || isMember();
    }

    match /settings/{documentId} {
      allow read: if isAdmin() || isMember() || isVocalist() || isGuest();
      allow create, update, delete: if isAdmin();
    }

    match /bandClick/session {
      allow read: if canUseBandClick();
      allow create, update: if (isAdmin() || isBandClickMaster())
        && validBandClickSession();
      allow delete: if isAdmin();
    }

    match /bandClickClients/{userId} {
      allow get: if isAdmin() || (canUseBandClick() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update: if canUseBandClick()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'clientSentAt',
          'serverTime',
          'updatedAt'
        ]);
      allow delete: if isAdmin() || (canUseBandClick() && request.auth.uid == userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
